# Which chain the frontend talks to: "monadTestnet" or "localhost" (npx hardhat node)
NEXT_PUBLIC_CHAIN=monadTestnet
# Printed by scripts/deploy.js
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_TOKEN_ADDRESS=
# https://cloud.reown.com - optional, a default is built in
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deploy only (never commit a real key)
DEPLOYER_PRIVATE_KEY=
MONAD_TESTNET_RPC_URL=
MOVE_TIMEOUT_SECONDS=86400
