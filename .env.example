# Which chain the frontend talks to: "monadTestnet" or "localhost" (npx hardhat node)
NEXT_PUBLIC_CHAIN=monadTestnet
# Printed by scripts/deploy.js
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_NAMES_ADDRESS=
# Server-side faucet key for /api/drip (testnet funds only)
FAUCET_PRIVATE_KEY=
# Discord: a channel webhook that /api/feedback posts player feedback to (a secret, server only),
# and the public invite link shown in the footer and the feedback form
DISCORD_FEEDBACK_WEBHOOK=
# Optional: a separate channel webhook for finished-game reports (/api/announce); defaults to the feedback one
DISCORD_RESULTS_WEBHOOK=
# Optional: a separate channel for low-balance alerts (faucet under 10 MON, referee under 0.5 MON); defaults to the feedback one.
# FAUCET_ALERT_MON and REFEREE_ALERT_MON change those thresholds.
DISCORD_ALERTS_WEBHOOK=
NEXT_PUBLIC_DISCORD_URL=
# Chess.com rating links (/api/rating sends with FAUCET_PRIVATE_KEY, which must be a reporter on ChessRatings).
# Local runs only: the ratings contract and forwarder printed by `npm run deploy:local`, and optionally a stand-in for chess.com.
NEXT_PUBLIC_RATINGS_ADDRESS=
RATINGS_FORWARDER=
RATING_API_BASE=

# Deploy only (never commit a real key)
DEPLOYER_PRIVATE_KEY=
MONAD_TESTNET_RPC_URL=
MOVE_TIMEOUT_SECONDS=86400
