# Which chain the frontend talks to: "arbitrumSepolia" or "localhost" (npx hardhat node)
NEXT_PUBLIC_CHAIN=arbitrumSepolia
# Printed by scripts/deploy.js
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_TOKEN_ADDRESS=0xb1D4538B4571d411F07960EF2838Ce337FE1E80E
# https://cloud.reown.com - optional, a default is built in
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deploy only (never commit a real key)
DEPLOYER_PRIVATE_KEY=
ARBITRUM_SEPOLIA_RPC_URL=
MOVE_TIMEOUT_SECONDS=86400
