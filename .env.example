# Which chain the frontend talks to: "monadTestnet" or "localhost" (npx hardhat node)
NEXT_PUBLIC_CHAIN=monadTestnet
# Printed by scripts/deploy.js
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_NAMES_ADDRESS=
# Server-side faucet key for /api/drip (testnet funds only)
FAUCET_PRIVATE_KEY=
# Discord: a channel webhook that /api/feedback posts player feedback to (a secret, server only),
# and the public invite link shown in the footer and the feedback form
DISCORD_FEEDBACK_WEBHOOK=
NEXT_PUBLIC_DISCORD_URL=

# Deploy only (never commit a real key)
DEPLOYER_PRIVATE_KEY=
MONAD_TESTNET_RPC_URL=
MOVE_TIMEOUT_SECONDS=86400
